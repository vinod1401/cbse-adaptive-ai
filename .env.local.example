# Google AI Studio Gemini API Key (100% Free - 1,500 requests per day)
# Get your free key instantly at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Security Secrets (CRITICAL for Production Deployments on Vercel):
# Set unique, high-entropy secrets in your Vercel Environment Variables:
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate_a_random_32_character_secret_here
PROFILE_SIGN_SECRET=generate_another_random_32_character_secret_here

# Teacher / Admin Dashboard Access PIN (Default: 1234)
TEACHER_ADMIN_PIN=1234

# Shared Storage for Multi-Instance / Serverless Scaling (Upstash Redis / Vercel KV):
# 100% Free tier available at: https://upstash.com/ (10,000 requests/day, zero cost)
# Or add "Upstash Redis" with 1-click inside Vercel Dashboard -> Storage -> Create Database -> Redis.
# If omitted, the app gracefully uses high-performance in-memory storage.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Alternative Vercel KV aliases (if using Vercel KV):
# KV_REST_API_URL=https://your-vercel-kv-instance.kv.vercel-storage.com
# KV_REST_API_TOKEN=your_vercel_kv_rest_token_here
