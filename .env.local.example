# Google AI Studio Gemini API Key (100% Free - 1,500 requests per day)
# Get your free key instantly at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Security Secrets (CRITICAL for Production Deployments on Vercel):
# Set unique, high-entropy secrets in your Vercel Environment Variables:
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate_a_random_32_character_secret_here
PROFILE_SIGN_SECRET=generate_another_random_32_character_secret_here

# Teacher / Admin Dashboard Access PIN (Default: 1234)
TEACHER_ADMIN_PIN=1234
